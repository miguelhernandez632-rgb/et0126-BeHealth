import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

void main() {
  runApp(const MiApp());
}

class AulaData extends ChangeNotifier {
  final List<Map<String, String>> contenido = [
    {
      'title': '¿Qué es?',
      'body': 'Flutter es un framework de Google para crear interfaces en múltiples plataformas con un solo código.'
    },
    {
      'title': '¿Cómo se organiza?',
      'body': 'La interfaz se construye con widgets, que se combinan en una jerarquía para formar la pantalla.'
    },
    {
      'title': 'Idea clave',
      'body': 'Todo en flutter es un widget'
    }
  ];
}

class MiApp extends StatelessWidget {
  const MiApp({super.key});

  @override
  Widget build(BuildContext context) {
    return ChangeNotifierProvider<AulaData>(
      create: (context) => AulaData(),
      builder: (context, child) => const MaterialApp(
        debugShowCheckedModeBanner: false,
        home: ArticuloPage(),
      ),
    );
  }
}

class ArticuloPage extends StatelessWidget {
  const ArticuloPage({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Aula móvil')),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(24.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Flutter: una interfaz hecha de piezas',
              style: TextStyle(
                fontSize: 32,
                fontWeight: FontWeight.w900,
              ),
            ),
            const SizedBox(height: 12),
            const Text(
              'Construye aplicaciones hermosas y funcionales, una pieza a la vez.',
              style: TextStyle(
                fontSize: 18,
                color: Colors.black54,
              ),
            ),
            const Padding(
              padding: EdgeInsets.symmetric(vertical: 24.0),
              child: Divider(),
            ),
            Consumer<AulaData>(
              builder: (context, data, child) {
                // We show first two in a wrap, then the third full width
                final mainItems = data.contenido.take(2).toList();
                final highlightItem = data.contenido.length > 2 ? data.contenido[2] : null;

                return Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Wrap(
                      spacing: 24,
                      runSpacing: 24,
                      children: mainItems.map<Widget>((item) {
                        return SizedBox(
                          width: MediaQuery.of(context).size.width > 600 ? 300 : double.infinity,
                          child: ContentItem(item: item),
                        );
                      }).toList(),
                    ),
                    if (highlightItem != null) ...[
                      const SizedBox(height: 32),
                      Container(
                        padding: const EdgeInsets.all(24),
                        decoration: BoxDecoration(
                          color: Colors.blue.shade50,
                          borderRadius: BorderRadius.circular(16),
                          border: Border.all(color: Colors.blue.shade100),
                        ),
                        child: ContentItem(item: highlightItem),
                      ),
                    ],
                  ],
                );
              },
            ),
          ],
        ),
      ),
    );
  }
}

class ContentItem extends StatelessWidget {
  final Map<String, String> item;

  const ContentItem({super.key, required this.item});

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Container(
          padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
          decoration: BoxDecoration(
            color: Colors.blue.withOpacity(0.1),
            borderRadius: BorderRadius.circular(4),
          ),
          child: Text(
            item['title']!,
            style: const TextStyle(
              fontSize: 20,
              fontWeight: FontWeight.bold,
              color: Colors.blueAccent,
            ),
          ),
        ),
        const SizedBox(height: 12),
        Text(
          item['body']!,
          style: const TextStyle(fontSize: 16, height: 1.5),
        ),
      ],
    );
  }
}
